{
  "name": "ai-agents-library",
  "version": "0.0.1",
  "description": "Общие модули для локальных агентских инструментов",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrey-Kovinjonok/ai-agents-library-.git"
  },
  "bugs": {
    "url": "https://github.com/Andrey-Kovinjonok/ai-agents-library-/issues"
  },
  "homepage": "https://github.com/Andrey-Kovinjonok/ai-agents-library-#readme",
  "type": "module",
  "files": [
    "LICENSE",
    "bin",
    "skills",
    "src",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "approval-continuation-hook": "./bin/approval-continuation-hook.js",
    "install-approval-continuation": "./bin/install-approval-continuation.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./project-locations": {
      "types": "./src/project-locations.d.ts",
      "import": "./src/project-locations.js"
    },
    "./branch-targets": {
      "types": "./src/branch-targets.d.ts",
      "import": "./src/branch-targets.js"
    },
    "./git-checkout": {
      "types": "./src/git-checkout.d.ts",
      "import": "./src/git-checkout.js"
    },
    "./approval-continuation": {
      "types": "./src/approval-continuation/index.d.ts",
      "import": "./src/approval-continuation/index.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
